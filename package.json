{
  "name": "express-sqlite-api-showcase",
  "version": "1.0.0",
  "description": "A local REST API showcase built with Express and SQLite, featuring JWT authentication. Clone and run — no external database needed.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/db/seed.js",
    "setup": "node src/db/schema.js && node src/db/seed.js"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "better-sqlite3": "11.9.1",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.0"
  },
  "devDependencies": {
    "nodemon": "3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "better-sqlite3@11.9.1": true,
    "fsevents@2.3.3": true
  }
}
