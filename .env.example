# Copy this file to .env and fill in your values
# cp .env.example .env

# Server
PORT=3001
NODE_ENV=development

# JWT — change these to long random strings in any real deployment
# You can generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars

# Token expiry
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SQLite database file path (relative to project root)
DB_PATH=./data/shop.db
